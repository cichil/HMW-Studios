{
  "name": "hmw-studio",
  "version": "4.0.0",
  "description": "HMW Studio — Native Desktop Web, PHP & Remote Server IDE with Project Manager, Visual SFTP/FTPS Synchronizer, Gemini AI, ConPTY/SSH Terminal, Git & Live Preview",
  "main": "./out/main/index.js",
  "author": "Hermawan Wiryana",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win --dir",
    "installer:win": "npm run build && electron-builder --win nsis",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "basic-ftp": "^6.2.6",
    "chokidar": "^6.0.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "simple-git": "^4.0.2",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.18"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.0",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "emmet-monaco-es": "^5.7.0",
    "lucide-react": "^1.73.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "com.hmw.studio",
    "productName": "HMW Studio",
    "copyright": "Copyright © 2026 Hermawan Wiryana",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/@lydell/**"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HMW Studio",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "artifactName": "HMW-Studio-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "HMW-Studio-${os}-${arch}.${ext}"
  }
}
